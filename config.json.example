{
    "token": "your bot token (prefer the DISCORD_TOKEN environment variable instead)",
    "homeserver_id": "ID of your server",
    "status": "/verify to get access",

    "verified_role": "ID of the role the bot grants upon verification",
    "verification_requirement_join": "90",
    "verification_requirement_message": "5",

    "moderator_mail_id": "ID of the bot which handles mod mail/tickets in your server",
    "moderator_role_IDs": ["role ID", "of each", "moderator role"],

    "log_channel_id": "ID of the audit log channel",
    "unboost_announcement_channel_id": "ID of the channel where unboosts are announced",
    "rules_channel_id": "ID of the rules channel linked in the verification message",
    "roles_channel_id": "ID of the self-assignable roles channel linked in the verification message",

    "colored_roles": ["452201509816369162", "623681022717984779"],

    "ontopic_category_id": "ID of the category where /emergency may be used",
    "emergency_role_id": "ID of the role that gets pinged for emergencies",
    "emergency_request_approval_threshold": "3",
    "emergency_request_deny_threshold": "2",
    "emergency_role_reminder": "180",
    "emergency_role_timeout": "5",
    "emergency_top_role_bypass_id": ["ID of a role that may ping without approval"],

    "irc_relay_id": "ID (or prefix) of the IRC relay Docker container; omit to disable /irc",
    "log_directory": "logs",
    "log_retention_days": "14"
}
